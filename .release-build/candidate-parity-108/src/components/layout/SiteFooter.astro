---
import pkg from '../../../package.json';

const year = new Date().getFullYear();
const version = pkg.version;
---

<footer class="relative border-t border-white/10 shadow-[var(--shadow-glass)] pb-[env(safe-area-inset-bottom)] bg-brand-ink/40 backdrop-blur-xl">
  <div class="h-[2px] w-full bg-gradient-to-r from-brand-green via-brand-yellow to-brand-blue-bright"></div>

  <div class="mx-auto w-full max-w-3xl px-4 py-1.5">
    <nav
      aria-label="Links institucionais do rodapé"
      class="flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 text-xs leading-tight text-white/80"
    >
      <span class="flex items-center gap-1 font-extrabold text-white">
        Supletivo <span class="text-emerald-400">Brasil</span>
      </span>
      <span class="text-white/40 select-none">·</span>
      <span class="text-white font-medium">CNPJ 48.811.016/0001-00</span>
      <span class="text-white/40 select-none">·</span>
      <a
        href="mailto:contato@supletivo.net.br"
        class="text-white underline underline-offset-2 transition hover:text-emerald-400"
      >
        contato@supletivo.net.br
      </a>
      <span class="text-white/40 select-none">·</span>
      <a
        href="https://supletivo.net.br/termos/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center font-semibold text-emerald-400 underline underline-offset-2 transition hover:text-emerald-300"
      >
        Termos
      </a>
      <span class="text-white/40 select-none">·</span>
      <a
        href="https://supletivo.net.br/privacidade/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center font-semibold text-emerald-400 underline underline-offset-2 transition hover:text-emerald-300"
      >
        Privacidade
      </a>
      <span class="text-white/40 select-none">·</span>
      <span class="text-white/60">© {year}</span>
      <span class="text-white/40 select-none">·</span>
      <span
        class="font-mono text-[10px] text-white/30 select-none tracking-tight hover:text-white/50 transition-colors"
        title="Versão da plataforma (version.v7m.live)"
      >
        v{version}
      </span>
    </nav>

    <div class="mt-1 flex flex-wrap items-center justify-center gap-2">
      <p class="text-center text-[11px] leading-snug text-white/70">
        Certificação por instituição credenciada ao MEC (Lei nº 9.394/96 — LDB). Dados tratados
        conforme a LGPD.
      </p>
    </div>
  </div>
</footer>
