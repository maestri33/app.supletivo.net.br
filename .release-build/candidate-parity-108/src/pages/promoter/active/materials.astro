---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Materiais de Divulgação — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="border-b border-white/10 pb-4">
      <span class="text-xs font-semibold text-[var(--yellow)] uppercase tracking-wider">Kit do Promotor</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Materiais de Apoio & Divulgação</h1>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-3">
        <span class="text-2xl">📱</span>
        <h3 class="text-base font-bold text-white">Criativos para Redes Sociais</h3>
        <p class="text-xs text-white/70">Posts, stories e reels prontos para WhatsApp, Instagram e Facebook.</p>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Baixar Pacote de Artes
        </button>
      </div>

      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-3">
        <span class="text-2xl">💬</span>
        <h3 class="text-base font-bold text-white">Scripts de Abordagem WhatsApp</h3>
        <p class="text-xs text-white/70">Mensagens validadas para quebrar objeções e converter alunos.</p>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Ver Modelos de Texto
        </button>
      </div>

      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-3">
        <span class="text-2xl">📄</span>
        <h3 class="text-base font-bold text-white">Panfletos e Cartazes em Alta Definição</h3>
        <p class="text-xs text-white/70">Arquivos prontos para impressão gráfica com espaço para seu contato.</p>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Baixar PDF Gráfico
        </button>
      </div>

      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-3">
        <span class="text-2xl">📊</span>
        <h3 class="text-base font-bold text-white">Apresentação Institucional MEC</h3>
        <p class="text-xs text-white/70">Explicação completa da validade da certificação e segurança jurídica.</p>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Visualizar Slides
        </button>
      </div>
    </div>
  </div>
</RootLayout>
