{
  "name": "app.supletivo.net.br",
  "version": "0.0.1-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3020",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview --port 3020",
    "check": "astro check",
    "sync": "astro sync",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/typesafe.test.ts tests/unit/roles.test.ts tests/unit/promoter.test.ts tests/unit/promoter-education.test.ts tests/unit/contact-recovery.test.ts tests/unit/rg-capture.test.ts tests/unit/address-proof.test.ts tests/unit/camera-session.test.ts tests/unit/promoter-weekly-commissions.test.ts tests/unit/otp-input.test.ts tests/unit/deadline.test.ts tests/unit/api-session.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:cli": "playwright-cli",
    "test:cli:show": "playwright-cli show",
    "checkpoint": "sh scripts/checkpoint/checkpoint.sh",
    "checkpoint:fast": "pwsh scripts/checkpoint/checkpoint.ps1 -Tier fast",
    "checkpoint:agent": "pwsh scripts/checkpoint/checkpoint.ps1 -Tier agent"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/node": "^11.1.5",
    "@astrojs/svelte": "^9.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "svelte": "^5.57.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.165.0"
  }
}
