---
import AppHeaderUser from '../interactive/AppHeaderUser.svelte';

interface Props {
  appName?: string;
  brandColor?: string;
}

const { appName = "Supletivo", brandColor } = Astro.props;
---

<header class="sticky top-0 z-30 flex justify-center border-b border-white/10 bg-brand-ink/35 pt-[env(safe-area-inset-top)] backdrop-blur-xl">
  <div class="flex w-full max-w-lg items-center gap-3 px-6 py-3">
    <span class="flex gap-1" aria-hidden="true">
      <span class="size-2 rounded-full bg-brand-green"></span>
      <span class="size-2 rounded-full bg-brand-yellow"></span>
      <span class="size-2 rounded-full bg-brand-blue-bright"></span>
    </span>
    <span class="text-sm font-extrabold tracking-tight text-white">
      {appName === "Supletivo" ? (
        <>
          Supletivo{" "}
          <span
            class={brandColor ? undefined : "text-brand-green-light"}
            style={brandColor ? `color: ${brandColor};` : undefined}
          >
            Brasil
          </span>
        </>
      ) : (
        appName
      )}
    </span>
    <div class="ml-auto flex items-center gap-2">
      <AppHeaderUser client:load />
    </div>
  </div>
</header>
