---
import AppHeader from '../components/layout/AppHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import RoleAdaptiveNavDock from '../components/interactive/RoleAdaptiveNavDock';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  showDock?: boolean;
  showFooter?: boolean;
}

const {
  title = "Supletivo Brasil — conclua seus estudos",
  description = "Conclua o Ensino Fundamental ou Médio pelo Supletivo Brasil. Matrícula rápida e 100% online.",
  showDock,
  showFooter = true,
} = Astro.props;

const pathname = Astro.url.pathname;
const isPublicAuthRoute = pathname.startsWith('/autenticacao') || pathname.startsWith('/pix');
const shouldRenderDock = showDock ?? !isPublicAuthRoute;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#002776" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />

    <!-- Fontes críticas pré-carregadas (elimina FOIT/FOUT) -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="application-name" content="Supletivo Brasil" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex h-dvh flex-col overflow-hidden bg-brand-bg text-brand-ink">
    <a
      href="#conteudo"
      class="sr-only rounded-lg focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-brand-ink focus:px-4 focus:py-2 focus:font-bold focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <!-- Aurora Background Zero-JS -->
    <div class="aurora-wrap" aria-hidden="true">
      <div class="aurora-layer"></div>
    </div>

    <!-- App Header -->
    <AppHeader />

    <!-- Área rolável da aplicação -->
    <div class="app-scroll">
      <slot />
    </div>

    <!-- Navegação Adaptativa Global (Dock Flutuante) -->
    {shouldRenderDock && (
      <RoleAdaptiveNavDock client:only="react" initialRole="aluno" currentPath={pathname} />
    )}

    <!-- Rodapé institucional Zero-JS -->
    {showFooter && <SiteFooter />}
  </body>
</html>
