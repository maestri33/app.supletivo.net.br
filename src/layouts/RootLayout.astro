---
import AppHeader from '../components/layout/AppHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Supletivo Brasil — conclua seus estudos",
  description = "Conclua o Ensino Fundamental ou Médio pelo Supletivo Brasil. Matrícula rápida e 100% online.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#012169" />
    <meta name="application-name" content="Supletivo Brasil" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex h-dvh flex-col overflow-hidden bg-brand-bg text-brand-ink">
    <a
      href="#conteudo"
      class="sr-only rounded-lg focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-brand-ink focus:px-4 focus:py-2 focus:font-bold focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <!-- Aurora Background Zero-JS -->
    <div class="aurora-wrap" aria-hidden="true">
      <div class="aurora-layer"></div>
    </div>

    <!-- App Header -->
    <AppHeader />

    <!-- Área rolável da aplicação -->
    <div class="app-scroll">
      <slot />
    </div>

    <!-- Rodapé institucional Zero-JS -->
    <SiteFooter />
  </body>
</html>
