---
import RootLayout from '../../layouts/RootLayout.astro';
import HubActiveView from '../../components/interactive/HubActiveView.svelte';

export const prerender = false;
---

<RootLayout title="Secretaria de Polo (Active) — Supletivo Brasil">
  <script is:inline>
    // Guard de autenticação: redireciona para a raiz se deslogado
    try {
      const raw = localStorage.getItem("supletivo.login");
      if (!raw) {
        window.location.replace("/");
      } else {
        const session = JSON.parse(raw);
        if (!session || !session.access_token) {
          window.location.replace("/");
        }
      }
    } catch (e) {
      window.location.replace("/");
    }
  </script>
  <div class="w-full flex-1 flex flex-col p-4 sm:p-6 pb-28">
    <HubActiveView client:load />
  </div>
</RootLayout>
