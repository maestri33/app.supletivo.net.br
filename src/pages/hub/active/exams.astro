---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Bancas & Provas Presenciais — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="border-b border-white/10 pb-4">
      <span class="text-xs font-semibold text-sky-400 uppercase tracking-wider">Secretaria de Polo</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Bancas Examinadoras & Sessões</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-sky-400 uppercase">Sessão Presencial Polo Central</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Hoje às 14:00</span>
        </div>
        <h3 class="text-lg font-bold text-white">Banca Geral de Ensino Médio</h3>
        <p class="text-xs text-white/70">8 candidatos confirmados. Atas impressas prontas para assinatura física.</p>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Abrir Ata de Chamada
        </button>
      </div>

      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-amber-400 uppercase">Sessão Online com Biometria</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300">Amanhã às 10:00</span>
        </div>
        <h3 class="text-lg font-bold text-white">Banca Remota Monitorada</h3>
        <p class="text-xs text-white/70">12 alunos agendados. Validação de reconhecimento facial em tempo real.</p>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Monitorar Sala Virtual
        </button>
      </div>
    </div>
  </div>
</RootLayout>
