---
import RootLayout from '../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Secretaria de Polo — Supletivo Brasil" requireAuth={false}>
  <script is:inline>
    (async function triageHub() {
      try {
        const raw = localStorage.getItem("supletivo.login");
        if (!raw) {
          window.location.replace("/");
          return;
        }
        const session = JSON.parse(raw);
        if (!session || !session.access_token) {
          window.location.replace("/");
          return;
        }

        // Confere se o usuário tem a permissão de polo/coordenador antes de acessar
        try {
          const whoResp = await fetch("/api/v1/clients/whoami", {
            headers: {
              "Authorization": "Bearer " + session.access_token,
              "Accept": "application/json"
            }
          });
          if (whoResp.ok) {
            const who = await whoResp.json();
            const roles = Array.isArray(who.roles) ? who.roles : [];
            const hasHubRole = roles.some((r) => ["coordinator", "hub", "polo"].includes(r));
            if (!hasHubRole) {
              window.location.replace("/student");
              return;
            }
          }
        } catch (e) {}

        try {
          const resp = await fetch("/api/v1/leadership/reviews", {
            headers: {
              "Authorization": "Bearer " + session.access_token,
              "Accept": "application/json"
            }
          });

          if (resp.ok) {
            const data = await resp.json();
            const queuesCount =
              (Array.isArray(data.enrollment_rg) ? data.enrollment_rg.length : 0) +
              (Array.isArray(data.enrollment_selfie) ? data.enrollment_selfie.length : 0) +
              (Array.isArray(data.candidate_document) ? data.candidate_document.length : 0) +
              (Array.isArray(data.candidate_selfie) ? data.candidate_selfie.length : 0) +
              (Array.isArray(data.student_documents) ? data.student_documents.length : 0) +
              (Array.isArray(data.candidates_awaiting_approval) ? data.candidates_awaiting_approval.length : 0);
            const totalPending = queuesCount || (data.total_pending ?? 0);
            if (totalPending > 0) {
              window.location.replace("/hub/review");
              return;
            }
          }
        } catch (e) {}

        // Padrão: hub ativo
        window.location.replace("/hub/active");
      } catch (e) {
        window.location.replace("/");
      }
    })();
  </script>
  <div class="w-full flex-1 flex items-center justify-center p-8 text-white/70">
    <div class="flex items-center gap-3">
      <div class="size-5 rounded-full border-2 border-[var(--yellow)] border-t-transparent animate-spin"></div>
      <span class="text-sm font-medium">Carregando ambiente do polo...</span>
    </div>
  </div>
</RootLayout>
