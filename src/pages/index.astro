---
import RootLayout from '../layouts/RootLayout.astro';
import UniversalLogin from '../components/interactive/UniversalLogin.svelte';

export const prerender = false;

const searchParams = Astro.url.searchParams;
const isExplicitSwitch = searchParams.has("trocar") || searchParams.has("switch") || searchParams.has("tel") || searchParams.has("logout");
const authCookie = Astro.cookies.get("supletivo.auth")?.value;
if (isExplicitSwitch) {
  Astro.cookies.delete("supletivo.auth", { path: "/" });
} else if (authCookie) {
  return Astro.redirect(authCookie === "admin" ? '/admin/dashboard' : '/student', 302);
}
---

<RootLayout title="Entrar — Supletivo Brasil" showDock={false}>
  <div class="w-full flex-1 flex flex-col items-center justify-start my-auto p-4 sm:p-6">
    <UniversalLogin client:load />
  </div>
</RootLayout>
