---
import RootLayout from '../layouts/RootLayout.astro';
import UniversalLogin from '../components/interactive/UniversalLogin.svelte';

export const prerender = false;

const search = Astro.url.search;
const searchParams = Astro.url.searchParams;

// Issue #8: Se contiver role=promotor/promoter ou rota explícita de promotor, não ejetar para a LP B2C de alunos
const roleVal = (searchParams.get("role") ?? "").toLowerCase();
const isPromoterContext = ["promotor", "promoter"].includes(roleVal) || searchParams.has("promotor") || searchParams.has("promoter");

// Se o usuário acessou a raiz com parâmetro de afiliado ou campanha de aluno,
// redireciona 308 permanentemente para a Landing Page oficial preservando a atribuição.
const hasMarketingParam =
  !isPromoterContext &&
  (searchParams.has("ref") ||
   Array.from(searchParams.keys()).some((k) => k.startsWith("utm_") || k.endsWith("clid")));

if (hasMarketingParam) {
  return Astro.redirect(`https://supletivo.net.br${search}`, 308);
}
---

<RootLayout title="Entrar — Supletivo Brasil" showDock={false}>
  <script is:inline>
    // Se o usuário já tiver sessão ativa, redireciona instantaneamente antes do render
    try {
      const raw = localStorage.getItem("supletivo.login");
      if (raw) {
        const session = JSON.parse(raw);
        if (session && session.access_token) {
          const roles = Array.isArray(session.roles) ? session.roles : [];
          const normalized = roles.map(function(r) { return String(r).toLowerCase().trim(); });
          if (normalized.some(function(r) { return ["coordinator", "hub", "polo", "staff", "superuser"].indexOf(r) !== -1; })) {
            window.location.replace("/hub");
          } else if (normalized.some(function(r) { return ["promoter", "candidate", "training", "promotor"].indexOf(r) !== -1; })) {
            window.location.replace("/promoter");
          } else {
            window.location.replace("/student");
          }
        }
      }
    } catch (e) {}
  </script>
  <div class="w-full flex-1 flex items-center justify-center p-4">
    <UniversalLogin client:load />
  </div>
</RootLayout>
