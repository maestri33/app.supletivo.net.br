---
export const prerender = false;

const search = Astro.url.search;
const searchParams = Astro.url.searchParams;

// Issue #8: Se contiver role=promotor ou rota explícita de promotor, não ejetar para a LP B2C de alunos
const isPromoterContext = searchParams.get("role") === "promotor" || searchParams.has("promotor");

// Se o usuário acessou a raiz com parâmetro de afiliado ou campanha de aluno,
// redireciona 308 permanentemente para a Landing Page oficial preservando a atribuição.
const hasMarketingParam =
  !isPromoterContext &&
  (searchParams.has("ref") ||
   Array.from(searchParams.keys()).some((k) => k.startsWith("utm_") || k.endsWith("clid")));

if (hasMarketingParam) {
  return Astro.redirect(`https://supletivo.net.br${search}`, 308);
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supletivo Brasil — Plataforma de Acesso</title>
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      // Triagem instantânea client-side: avalia sessão no localStorage antes do paint (0ms)
      try {
        const raw = localStorage.getItem("supletivo.login");
        if (raw) {
          const session = JSON.parse(raw);
          if (session && session.access_token) {
            window.location.replace("/painel");
          } else {
            window.location.replace("/autenticacao/login");
          }
        } else {
          window.location.replace("/autenticacao/login");
        }
      } catch (e) {
        window.location.replace("/autenticacao/login");
      }
    </script>
    <style>
      body {
        margin: 0;
        background: #001a52;
      }
    </style>
  </head>
  <body></body>
</html>
