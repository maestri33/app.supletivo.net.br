---
import RootLayout from '../layouts/RootLayout.astro';
import DynamicRoleShell from '../components/interactive/DynamicRoleShell.svelte';
import RoleAdaptiveNavDock from '../components/interactive/RoleAdaptiveNavDock';

export const prerender = false;
---

<RootLayout title="Portal de Acesso — Supletivo Brasil">
  <div class="w-full flex-1 flex flex-col p-4 sm:p-6 pb-28">
    <DynamicRoleShell client:load />

    <!-- Island interativa React com hidratação sob demanda -->
    <RoleAdaptiveNavDock client:load initialRole="aluno" currentPath={Astro.url.pathname} />
  </div>
</RootLayout>
