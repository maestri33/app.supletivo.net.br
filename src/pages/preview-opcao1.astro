---
import RootLayout from '../layouts/RootLayout.astro';
import {
  IconHome,
  IconFileText,
  IconSchool,
  IconAward,
  IconHelpCircle,
  IconDoorExit,
} from '@tabler/icons-react';

export const prerender = false;
---

<RootLayout title="Opção 1: Bottom Tab Bar Nativa — Supletivo Brasil" showDock={false} showFooter={false}>
  <!-- Conteúdo de teste com rolagem -->
  <div class="w-full max-w-2xl mx-auto p-4 sm:p-6 space-y-6 pb-28 text-white">
    <div class="text-center space-y-2 py-4">
      <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-bold rounded-full uppercase tracking-wider border border-emerald-500/30">
        Opção 1 Integrada
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold font-display">
        Bottom Tab Bar Nativa
      </h1>
      <p class="text-sm text-white/70">
        Sem sobreposição de rodapé. Barra de navegação integrada e limpa.
      </p>
    </div>

    <!-- Card de Conteúdo 1 -->
    <div class="p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-emerald-400 uppercase">Status Acadêmico</span>
        <span class="text-xs bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full">Ativo</span>
      </div>
      <h2 class="text-xl font-bold">Ensino Médio EJA Integrado</h2>
      <p class="text-sm text-white/75 leading-relaxed">
        Ambiente do aluno 100% online. As aulas, simulados e apostilas são liberados conforme a conferência documental pelo polo de apoio.
      </p>
    </div>

    <!-- Card de Conteúdo 2 -->
    <div class="p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md space-y-3">
      <span class="text-xs font-semibold text-amber-400 uppercase">Pendência Documental</span>
      <h3 class="text-lg font-bold">Comprovante de Residência</h3>
      <p class="text-sm text-white/75 leading-relaxed">
        Envie uma foto legível do seu comprovante com no máximo 90 dias para prosseguir com a emissão do contrato pedagógico.
      </p>
    </div>
  </div>

  <!-- A Opção 1: Bottom Navigation Bar Integrada (Estilo App Nativo) -->
  <nav
    aria-label="Navegação principal da aplicação"
    class="fixed bottom-0 inset-x-0 z-40 border-t border-white/10 bg-brand-ink/85 backdrop-blur-2xl shadow-[0_-8px_32px_rgba(0,0,0,0.5)] pb-[env(safe-area-inset-bottom)]"
  >
    <div class="h-[2px] w-full bg-gradient-to-r from-brand-green via-brand-yellow to-brand-blue-bright"></div>
    <div class="mx-auto flex w-full max-w-lg items-center justify-around px-2 py-2">
      <!-- Item 1: Início -->
      <a
        href="#"
        class="flex flex-col items-center gap-1 p-2 rounded-xl text-brand-yellow font-bold transition-transform active:scale-95"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <IconHome className="h-5 w-5" />
        </div>
        <span class="text-[10px] tracking-tight">Curso</span>
      </a>

      <!-- Item 2: Documentos -->
      <a
        href="#"
        class="flex flex-col items-center gap-1 p-2 rounded-xl text-white/70 hover:text-white transition-transform active:scale-95 relative"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <IconFileText className="h-5 w-5" />
          <span class="absolute -top-1 -right-1 flex h-3.5 min-w-3.5 items-center justify-center rounded-full bg-amber-500 px-1 text-[9px] font-black text-black">
            !
          </span>
        </div>
        <span class="text-[10px] tracking-tight">Docs</span>
      </a>

      <!-- Item 3: Provas -->
      <a
        href="#"
        class="flex flex-col items-center gap-1 p-2 rounded-xl text-white/70 hover:text-white transition-transform active:scale-95"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <IconSchool className="h-5 w-5" />
        </div>
        <span class="text-[10px] tracking-tight">Provas</span>
      </a>

      <!-- Item 4: Certificação -->
      <a
        href="#"
        class="flex flex-col items-center gap-1 p-2 rounded-xl text-white/70 hover:text-white transition-transform active:scale-95"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <IconAward className="h-5 w-5" />
        </div>
        <span class="text-[10px] tracking-tight">Diploma</span>
      </a>

      <!-- Item 5: Suporte -->
      <a
        href="#"
        class="flex flex-col items-center gap-1 p-2 rounded-xl text-white/70 hover:text-white transition-transform active:scale-95"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <IconHelpCircle className="h-5 w-5" />
        </div>
        <span class="text-[10px] tracking-tight">Ajuda</span>
      </a>

      <!-- Item 6: Sair -->
      <button
        type="button"
        class="flex flex-col items-center gap-1 p-2 rounded-xl text-rose-400/80 hover:text-rose-400 transition-transform active:scale-95 cursor-pointer"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <IconDoorExit className="h-5 w-5" />
        </div>
        <span class="text-[10px] tracking-tight">Sair</span>
      </button>
    </div>
  </nav>
</RootLayout>