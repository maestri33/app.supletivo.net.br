---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Conta Suspensa — Supletivo Brasil">
  <div class="w-full max-w-lg mx-auto flex-1 flex flex-col items-center justify-center p-4 sm:p-6 pb-28 text-center space-y-4">
    <div class="size-16 rounded-2xl bg-rose-500/20 border border-rose-500/30 flex items-center justify-center text-3xl mx-auto text-rose-400">
      ⚠️
    </div>
    <div class="space-y-1">
      <span class="px-3 py-1 rounded-full bg-rose-500 text-white text-xs font-black uppercase tracking-wider">
        Conta Temporariamente Suspensa
      </span>
      <h1 class="text-2xl font-black text-white font-display pt-2">Acesso Restrito para Auditoria</h1>
      <p class="text-xs text-white/70 max-w-sm mx-auto leading-relaxed">
        Seu painel de divulgação foi suspenso preventivamente para regularização cadastral ou verificação de conformidade de repasse. Entre em contato com a coordenação do polo regional para reativar seu cadastro.
      </p>
    </div>
    <div class="pt-2">
      <a href="/promoter/suspended/support" class="btn px-6 py-3 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
        Falar com o Coordenador do Polo &rarr;
      </a>
    </div>
  </div>
</RootLayout>
