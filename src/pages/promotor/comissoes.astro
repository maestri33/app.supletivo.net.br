---
import RootLayout from '../../layouts/RootLayout.astro';
import PromoterCommissionsView from '../../components/interactive/PromoterCommissionsView.svelte';

export const prerender = false;
---

<RootLayout title="Comissões & Extrato PIX — Supletivo Brasil">
  <script is:inline>
    try {
      const raw = localStorage.getItem("supletivo.login");
      if (!raw) {
        window.location.replace("/?role=promoter");
      } else {
        const session = JSON.parse(raw);
        if (!session || !session.access_token) {
          window.location.replace("/?role=promoter");
        }
      }
    } catch (e) {
      window.location.replace("/?role=promoter");
    }
  </script>
  <div class="w-full flex-1 flex flex-col p-4 sm:p-6 pb-28">
    <PromoterCommissionsView client:load />
  </div>
</RootLayout>
