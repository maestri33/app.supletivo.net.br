---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Painel do Aluno — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-4">
      <div>
        <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Ambiente Pedagógico Ativo</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Meu Painel de Estudos</h1>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-bold">
          Matrícula Regular
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md space-y-2">
        <span class="text-xs text-white/60 uppercase font-semibold">Progresso Geral</span>
        <div class="text-3xl font-extrabold text-white">45%</div>
        <div class="w-full h-2 rounded-full bg-white/10 overflow-hidden">
          <div class="h-full bg-[var(--yellow)] rounded-full" style="width: 45%;"></div>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md space-y-2">
        <span class="text-xs text-white/60 uppercase font-semibold">Disciplinas Concluídas</span>
        <div class="text-3xl font-extrabold text-white">5 / 11</div>
        <p class="text-xs text-white/60">6 disciplinas restantes para a banca.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md space-y-2">
        <span class="text-xs text-white/60 uppercase font-semibold">Próxima Avaliação</span>
        <div class="text-xl font-bold text-emerald-400">Liberada</div>
        <p class="text-xs text-white/60">Agende sua prova presencial ou online.</p>
      </div>
    </div>
  </div>
</RootLayout>
