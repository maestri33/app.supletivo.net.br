---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Disciplinas & Conteúdos — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="border-b border-white/10 pb-4">
      <span class="text-xs font-semibold text-[var(--yellow)] uppercase tracking-wider">Ensino Médio</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Disciplinas & Apostilas</h1>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">Língua Portuguesa & Literatura</h3>
          <span class="text-xs text-emerald-400">Concluído (Nota: 9.5)</span>
        </div>
        <span class="text-2xl">📖</span>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">Matemática & Raciocínio Lógico</h3>
          <span class="text-xs text-amber-400">Em Andamento (Módulo 3/4)</span>
        </div>
        <span class="text-2xl">📐</span>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">História & Geografia Geral</h3>
          <span class="text-xs text-white/50">Aguardando Início</span>
        </div>
        <span class="text-2xl">🌍</span>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">Biologia, Física & Química</h3>
          <span class="text-xs text-white/50">Aguardando Início</span>
        </div>
        <span class="text-2xl">🔬</span>
      </div>
    </div>
  </div>
</RootLayout>
