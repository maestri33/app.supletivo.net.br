---
import RootLayout from '../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Portal do Aluno — Supletivo Brasil">
  <script is:inline>
    (async function triageStudent() {
      try {
        const raw = localStorage.getItem("supletivo.login");
        if (!raw) {
          window.location.replace("/");
          return;
        }
        const session = JSON.parse(raw);
        if (!session || !session.access_token) {
          window.location.replace("/");
          return;
        }

        // Consulta endpoints do aluno para definir se deve ir para lead ou enrollment
        try {
          const resp = await fetch("/api/v1/clients/lead/me", {
            headers: {
              "Authorization": "Bearer " + session.access_token,
              "Accept": "application/json"
            }
          });

          if (resp.ok) {
            const data = await resp.json();
            // Se checkout não foi pago, status é lead
            if (data && data.checkout && !data.checkout.is_paid) {
              window.location.replace("/student/lead");
              return;
            }
          }
        } catch (e) {}

        // Se pago ou em fase de matrícula/documentos, direciona para enrollment
        window.location.replace("/student/enrollment");
      } catch (e) {
        window.location.replace("/");
      }
    })();
  </script>
  <div class="w-full flex-1 flex items-center justify-center p-8 text-white/70">
    <div class="flex items-center gap-3">
      <div class="size-5 rounded-full border-2 border-[var(--yellow)] border-t-transparent animate-spin"></div>
      <span class="text-sm font-medium">Carregando ambiente do aluno...</span>
    </div>
  </div>
</RootLayout>
