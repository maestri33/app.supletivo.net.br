---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Parabéns Concluinte — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="p-8 rounded-3xl bg-gradient-to-br from-emerald-950/40 via-white/5 to-emerald-900/20 border border-emerald-500/40 backdrop-blur-xl text-center space-y-4">
      <div class="size-20 rounded-full bg-emerald-500/20 border border-emerald-400/50 flex items-center justify-center text-4xl mx-auto shadow-2xl">
        🎓
      </div>
      <div class="space-y-1">
        <span class="px-3 py-1 rounded-full bg-emerald-500 text-black text-xs font-black uppercase tracking-wider">
          Ensino Médio Concluído
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-white font-display pt-2">Parabéns pela sua Formatura!</h1>
        <p class="text-sm text-white/80 max-w-md mx-auto">
          Você concluiu com sucesso todas as disciplinas e avaliações exigidas pelo MEC.
        </p>
      </div>
      <div class="pt-4 flex flex-wrap justify-center gap-3">
        <a href="/student/veteran/diploma" class="btn px-6 py-3 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Baixar Certificado Digital &rarr;
        </a>
        <a href="/student/veteran/records" class="px-6 py-3 rounded-xl border border-white/20 hover:border-white/40 text-xs font-bold text-white transition-all">
          Ver Histórico Escolar
        </a>
      </div>
    </div>
  </div>
</RootLayout>
