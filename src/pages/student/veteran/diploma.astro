---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Diploma Oficial MEC — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="border-b border-white/10 pb-4">
      <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Publicação Oficial</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Diploma de Conclusão do Ensino Médio</h1>
    </div>

    <div class="p-8 rounded-3xl bg-gradient-to-br from-amber-500/10 via-white/5 to-emerald-500/10 border border-amber-400/30 backdrop-blur-xl space-y-6">
      <div class="flex items-center gap-4">
        <div class="size-16 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-3xl">
          🎖️
        </div>
        <div>
          <h3 class="text-xl font-bold text-white">Diploma Registrado no MEC / Diário Oficial</h3>
          <p class="text-xs text-white/70">Válido em todo território nacional para ingresso em Faculdades, Concursos Públicos e Empregos.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl bg-black/20 border border-white/10 space-y-1">
          <span class="text-[10px] uppercase font-bold text-white/60">Número de Registro</span>
          <div class="text-sm font-mono font-bold text-amber-300">BR-MEC-2026-992140</div>
        </div>
        <div class="p-4 rounded-xl bg-black/20 border border-white/10 space-y-1">
          <span class="text-[10px] uppercase font-bold text-white/60">Publicação em Diário Oficial</span>
          <div class="text-sm font-mono font-bold text-emerald-300">DOE-PR Nº 11.482 — FLS. 84</div>
        </div>
      </div>

      <div class="pt-2 flex flex-wrap gap-3">
        <button type="button" class="btn px-6 py-3 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Baixar Certificado Oficial Assinado (PDF)
        </button>
        <button type="button" class="px-6 py-3 rounded-xl border border-white/20 hover:border-white/40 text-xs font-bold text-white transition-all">
          Solicitar Via Física Impressa
        </button>
      </div>
    </div>
  </div>
</RootLayout>
