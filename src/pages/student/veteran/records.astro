---
import RootLayout from '../../../layouts/RootLayout.astro';

export const prerender = false;
---

<RootLayout title="Histórico Escolar Oficial — Supletivo Brasil">
  <div class="w-full max-w-4xl mx-auto flex-1 flex flex-col p-4 sm:p-6 pb-28 space-y-6">
    <div class="border-b border-white/10 pb-4">
      <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Documento Oficial</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Histórico Escolar Consolidado</h1>
    </div>

    <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md space-y-4">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <span class="text-sm font-bold text-white">Certidão de Conclusão da Educação Básica</span>
        <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          Homologado no GDAE / SISTEC
        </span>
      </div>
      <p class="text-xs text-white/70 leading-relaxed">
        O documento abaixo contém a relação completa de componentes curriculares cursados, carga horária cumprida e notas obtidas conforme as diretrizes do Conselho Estadual de Educação.
      </p>
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📄</span>
          <div>
            <h4 class="text-xs font-bold text-white">historico_escolar_oficial_concluinte.pdf</h4>
            <span class="text-[10px] text-white/50">Assinado digitalmente via ICP-Brasil</span>
          </div>
        </div>
        <button type="button" class="btn px-4 py-2 text-xs font-bold uppercase tracking-wider text-[var(--ink)]">
          Download PDF
        </button>
      </div>
    </div>
  </div>
</RootLayout>
