---
import RootLayout from '../layouts/RootLayout.astro';
import RoleStatusTabs from '../components/interactive/RoleStatusTabs';

export const prerender = false;
---

<RootLayout title="Tabs de Status & Floating Dock Adaptativo — Supletivo Brasil" showDock={false} showFooter={false}>
  <main class="w-full flex-1 flex flex-col items-center justify-start p-4 sm:p-6">
    <div class="text-center space-y-2 py-4 max-w-2xl">
      <span class="px-3 py-1 bg-brand-yellow/20 text-brand-yellow text-xs font-bold rounded-full uppercase tracking-wider border border-brand-yellow/30">
        Multi-Role & Multi-Status
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold font-display text-white">
        Tabs de Status com Dock Adaptativo
      </h1>
      <p class="text-sm text-white/70">
        Para cada role, abas de status canônicos. Para cada status, o Floating Dock / Bottom Bar adapta seus itens, badges, alertas e ações imediatamente.
      </p>
    </div>

    <RoleStatusTabs client:load />
  </main>
</RootLayout>
