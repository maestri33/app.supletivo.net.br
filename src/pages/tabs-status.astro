---
import RootLayout from '../layouts/RootLayout.astro';
import RoleStatusTabs from '../components/interactive/RoleStatusTabs';

export const prerender = false;
---

<RootLayout title="Painel de Status e Navegação Adaptativa — Supletivo Brasil" showDock={false} showFooter={false} requireAuth={true}>
  <div class="w-full flex-1 flex flex-col items-center justify-start p-4 sm:p-6">
    <div class="text-center space-y-2 py-4 max-w-2xl">
      <span class="px-3 py-1 bg-brand-yellow/20 text-brand-yellow text-xs font-bold rounded-full uppercase tracking-wider border border-brand-yellow/30">
        Múltiplos Perfis e Etapas
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold font-display text-white">
        Abas de Status com Navegação Adaptativa
      </h1>
      <p class="text-sm text-white/70">
        Para cada perfil, abas de etapas operacionais. Para cada etapa, a barra inferior adapta seus itens, contadores, alertas e ações imediatamente.
      </p>
    </div>

    <RoleStatusTabs client:load />
  </div>
</RootLayout>
