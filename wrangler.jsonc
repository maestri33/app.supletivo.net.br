{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-supletivo-net-br",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": true,
  "vars": {
    "URL_BACKEND": "https://backend.supletivo.net.br"
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "app.supletivo.net.br/*",
      "zone_name": "supletivo.net.br"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "1500d22e396f41c6b26d9f17e02f678d"
    }
  ]
}
