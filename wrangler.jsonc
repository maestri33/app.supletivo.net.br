{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-supletivo-net-br",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.supletivo.net.br",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "app-supletivo-documents"
    }
  ]
}
